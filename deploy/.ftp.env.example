# deploy/.ftp.env olarak kopyalayın; gerçek dosya .gitignore'da
FTP_HOST=ftp.ankaradacocuk.com
FTP_USER=cpanel_kullanici_adi
FTP_PASS=cpanel_sifresi
# Addon domain ise cPanel > Domains'te görünen "Document Root" (örn. /ankaradacocuk.com veya /public_html/ankaradacocuk.com)
FTP_ROOT=/ankaradacocuk.com
